// ============================================================
// MOONA ERP — /api/admin-set-password
// Меняет пароль сотрудника и гасит ВСЕ его сессии (сайт + бот).
// Работает ТОЛЬКО на сервере с service_role-ключом.
// ============================================================
//
// ENV (Vercel → Settings → Environment Variables):
//   SUPABASE_URL                 = https://pedchyiwcnlwzzgkmxxj.supabase.co
//   SUPABASE_SERVICE_ROLE_KEY    = <секретный ключ из раздела Secret keys>
//   SUPABASE_ANON_KEY            = <публичный anon-ключ, тот же что в сайте>
//
// ВАЖНО: service_role-ключ НИКОГДА не попадает в браузер. Он читается
// здесь, на сервере, из process.env.
// ============================================================

const SUPABASE_URL = process.env.SUPABASE_URL;
const SERVICE_KEY  = process.env.SUPABASE_SERVICE_ROLE_KEY;
const ANON_KEY     = process.env.SUPABASE_ANON_KEY;

// Вызов Supabase Auth Admin API через service_role
async function authAdmin(method, path, body) {
  const r = await fetch(`${SUPABASE_URL}/auth/v1/admin/${path}`, {
    method,
    headers: {
      apikey: SERVICE_KEY,
      Authorization: `Bearer ${SERVICE_KEY}`,
      'Content-Type': 'application/json',
    },
    body: body ? JSON.stringify(body) : undefined,
  });
  return { ok: r.ok, status: r.status, data: await r.json().catch(() => ({})) };
}

// Чтение/запись таблицы users через service_role (обходит RLS)
async function dbGet(filter) {
  const r = await fetch(`${SUPABASE_URL}/rest/v1/users?${filter}`, {
    headers: { apikey: SERVICE_KEY, Authorization: `Bearer ${SERVICE_KEY}` },
  });
  return r.json();
}
async function dbPatch(id, data) {
  await fetch(`${SUPABASE_URL}/rest/v1/users?id=eq.${id}`, {
    method: 'PATCH',
    headers: {
      apikey: SERVICE_KEY,
      Authorization: `Bearer ${SERVICE_KEY}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(data),
  });
}

export default async function handler(req, res) {
  if (req.method !== 'POST') return res.status(405).json({ error: 'method' });

  if (!SUPABASE_URL || !SERVICE_KEY || !ANON_KEY) {
    return res.status(500).json({ error: 'env_missing' });
  }

  try {
    const { targetUserId, newPassword } = req.body || {};

    // --- 1) Проверяем, что запрос пришёл от АДМИНА -----------------
    // Сайт передаёт access_token текущего пользователя в заголовке.
    // Мы проверяем его через anon-ключ и смотрим роль в таблице users.
    const authHeader = req.headers.authorization || '';
    const callerToken = authHeader.replace('Bearer ', '').trim();
    if (!callerToken) return res.status(401).json({ error: 'no_token' });

    const who = await fetch(`${SUPABASE_URL}/auth/v1/user`, {
      headers: { apikey: ANON_KEY, Authorization: `Bearer ${callerToken}` },
    });
    if (!who.ok) return res.status(401).json({ error: 'bad_token' });
    const caller = await who.json();

    const callerRows = await dbGet(`auth_user_id=eq.${caller.id}&select=role`);
    const callerRole = Array.isArray(callerRows) && callerRows[0]?.role;
    if (callerRole !== 'admin') {
      return res.status(403).json({ error: 'not_admin' });
    }

    // --- 2) Валидация входных данных ------------------------------
    if (!targetUserId || !newPassword || String(newPassword).length < 6) {
      return res.status(400).json({ error: 'bad_input' }); // пароль минимум 6 символов
    }

    // Находим целевого сотрудника и его auth_user_id
    const targetRows = await dbGet(`id=eq.${targetUserId}&select=id,auth_user_id,name`);
    const target = Array.isArray(targetRows) && targetRows[0];
    if (!target || !target.auth_user_id) {
      return res.status(404).json({ error: 'target_not_found' });
    }

    // --- 3) Меняем пароль в Supabase Auth -------------------------
    const upd = await authAdmin('PUT', `users/${target.auth_user_id}`, {
      password: String(newPassword),
    });
    if (!upd.ok) return res.status(500).json({ error: 'update_failed', detail: upd.data });

    // --- 4) Гасим ВСЕ сессии сотрудника (это и есть logout везде) --
    // signOut по user id инвалидирует и веб-сессию, и refresh-токен бота.
    await authAdmin('POST', `users/${target.auth_user_id}/logout`, { scope: 'global' });

    // --- 5) Чистим бот-привязку, чтобы бот потребовал войти заново -
    await dbPatch(target.id, { tg_refresh_token: null });

    return res.status(200).json({ ok: true, name: target.name });
  } catch (e) {
    console.error('admin-set-password error:', e);
    return res.status(500).json({ error: 'server', detail: String(e) });
  }
}
